    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT cpf, whatsapp_from, nome_requerente, email, processos FROM consultas_esaj WHERE current_state = 'MANUAL_PROCESS'",
        "options": {}
      },
      "alwaysOutputData": true,
      "id": "query-consultas-esaj",
      "name": "Query consultas_esaj",
      "position": [
        144,
        0
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "credentials": {
        "postgres": {
          "id": "b0F0gRzrpEq6BR3M",
          "name": "Postgres account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $input.item.json;\n\n// Se a query nao retornou dados reais, encerra silenciosamente\nif (!row || !row.nome_requerente) {\n  return null;\n}\n\nconst cpf = row.cpf;\nconst whatsapp_from = row.whatsapp_from;\nconst nome_requerente = row.nome_requerente;\nconst email = row.email || 'não informado';\n\n// Parse do campo processos: pode ser objeto (postgres jsonb) ou string (text)\nlet lista_processos = [];\ntry {\n  let processosObj;\n  if (typeof row.processos === 'string') {\n    processosObj = JSON.parse(row.processos);\n  } else {\n    processosObj = row.processos;\n  }\n  lista_processos = (processosObj.lista || []).map(p => p.numero);\n} catch(e) {\n  lista_processos = ['Não foi possível extrair os números dos processos'];\n}\n\nconst processos_formatados_texto = lista_processos.join('\\n');\nconst processos_formatados_html = lista_processos.map(n => `<li>${n}</li>`).join('');\n\nconst msg_cliente = `Olá, ${nome_requerente}.\n\nIdentificamos que o processamento automático dos documentos do seu precatório não pôde ser concluído integralmente. Nossa equipe fará uma análise complementar e encaminhará o resultado para o e-mail cadastrado em até 7 dias úteis.\n\nVocê não precisa realizar uma nova solicitação ou pagamento.\n\nAgradecemos a compreensão.\n\nRevisa Precatório`;\n\nconst msg_interna_texto = `CPF ${cpf} do cliente ${nome_requerente} não foi processado e requer processamento manual, numero dos processos envolvidos:\\n${processos_formatados_texto}\\n\\ne enviar ao email ${email}`;\n\nconst msg_interna_html = `<p>CPF <strong>${cpf}</strong> do cliente <strong>${nome_requerente}</strong> não foi processado e requer processamento manual.</p><p><strong>Número dos processos envolvidos:</strong></p><ul>${processos_formatados_html}</ul><p>Enviar ao email: <a href=\"mailto:${email}\">${email}</a></p>`;\n\nreturn {\n  json: {\n    cpf,\n    whatsapp_from,\n    nome_requerente,\n    email,\n    msg_cliente,\n    msg_interna_texto,\n    msg_interna_html\n  }\n};"
      },
      "id": "code-prepara-mensagens",
      "name": "Prepara Mensagens",
      "position": [
        320,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "772929385904854",
        "recipientPhoneNumber": "={{ $json.whatsapp_from }}",
        "textBody": "={{ $json.msg_cliente }}",
        "additionalFields": {}
      },
      "id": "whatsapp-cliente",
      "name": "WhatsApp Cliente",
      "position": [
        496,
        0
      ],
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "webhookId": "f9c0840a-ba0d-4e98-9ae4-fdf34b075d13",
      "credentials": {
        "whatsAppApi": {
          "id": "ejhZtEKHF0Kh9HeQ",
          "name": "WhatsApp account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "fromEmail": "Revisa Precatório <contato@revisaprecatorio.com.br>",
        "toEmail": "revisa.manual@gmail.com",
        "subject": "={{ 'Erro processamento CPF ' + $('Prepara Mensagens').item.json.cpf + ' necessita intervenção manual' }}",
        "html": "={{ $('Prepara Mensagens').item.json.msg_interna_html }}",
        "options": {
          "appendAttribution": false
        }
      },
